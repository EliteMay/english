{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://elitemay.github.io/english/data/analysis-return.schema.json",
  "title":"English Worksheet Lab ChatGPT Analysis Return",
  "type":"object",
  "required":["weaknessAnalysisVersion","generatedAt","summary","weaknesses","strengths","nextTargets"],
  "properties":{
    "weaknessAnalysisVersion":{"const":2},
    "generatedAt":{"type":"string"},
    "summary":{"type":"string"},
    "weaknesses":{"type":"array","items":{"type":"object","required":["id","title","severity","confidence","cause","evidence","recommendedPackIds"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"severity":{"enum":["high","medium","low"]},"confidence":{"type":"number","minimum":0,"maximum":1},"cause":{"type":"string"},"evidence":{"type":"array","items":{"type":"string"}},"recommendedPackIds":{"type":"array","items":{"type":"string"}}}}},
    "strengths":{"type":"array","items":{"type":"object","required":["title","note"],"properties":{"title":{"type":"string"},"note":{"type":"string"}}}},
    "nextTargets":{"type":"array","items":{"type":"string"}},
    "skillProfile":{"type":"array","items":{"type":"object","required":["skill","label","confidence","note"],"properties":{"skill":{"type":"string"},"label":{"type":"string"},"score":{"type":["number","null"],"minimum":0,"maximum":100},"confidence":{"type":"number","minimum":0,"maximum":1},"note":{"type":"string"}}}},
    "readingHabits":{"type":"array","items":{"type":"object","required":["title","evidence","impact"],"properties":{"title":{"type":"string"},"evidence":{"type":"array","items":{"type":"string"}},"impact":{"type":"string"}}}},
    "siteRecommendations":{"type":"array","items":{"type":"object","required":["title","reason","priority"],"properties":{"title":{"type":"string"},"reason":{"type":"string"},"priority":{"enum":["high","medium","low"]}}}}
  },
  "additionalProperties":true
}
