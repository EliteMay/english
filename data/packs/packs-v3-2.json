[{"id":"verb-meaning","title":"同じ動詞でも構造が変わる","source":"教材③ベース","level":"標準→発展","focus":"動詞の意味と文型","description":"run / grow / look / sound / keep / make を対比して、単語ではなくその文での意味関係を見る。","questions":[{"id":"vm01","type":"choice","prompt":"文型を判定してください。","sentence":"He runs every morning.","choices":["SV","SVC","SVO"],"answer":"SV","skill":"verb-pattern","note":""},{"id":"vm02","type":"choice","prompt":"同じ run ですが、こちらの文型は？","sentence":"He runs a small café.","choices":["SV","SVC","SVO"],"answer":"SVO","skill":"verb-pattern","note":""},{"id":"vm03","type":"choice","prompt":"文型を判定してください。","sentence":"The tree grew quickly.","choices":["SV","SVC","SVO"],"answer":"SV","skill":"verb-pattern","note":""},{"id":"vm04","type":"choice","prompt":"同じ grow ですが、こちらの文型は？","sentence":"The sky grew dark.","choices":["SV","SVC","SVO"],"answer":"SVC","skill":"verb-pattern","note":""},{"id":"vm05","type":"choice","prompt":"文型を判定してください。","sentence":"She looked tired after the trip.","choices":["SV","SVC","SVO"],"answer":"SVC","skill":"verb-pattern","note":""},{"id":"vm06","type":"choice","prompt":"同じ look ですが、at以下の扱いに注意。","sentence":"She looked at me without saying anything.","choices":["SV","SVC","SVO"],"answer":"SV","skill":"verb-pattern","note":""},{"id":"vm07","type":"choice","prompt":"文型を判定してください。","sentence":"The plan sounds reasonable.","choices":["SV","SVC","SVO"],"answer":"SVC","skill":"verb-pattern","note":""},{"id":"vm08","type":"choice","prompt":"同じ sound ですが、こちらの文型は？","sentence":"The guard sounded the alarm.","choices":["SV","SVC","SVO"],"answer":"SVO","skill":"verb-pattern","note":""},{"id":"vm09","type":"fields","prompt":"S/V/O/Cを書いてください。","sentence":"He kept the door open during the meeting.","fields":[{"id":"s","label":"S","answers":["He"]},{"id":"v","label":"V","answers":["kept"]},{"id":"o","label":"O","answers":["the door"]},{"id":"c","label":"C","answers":["open"]}],"skill":"svoc","note":""},{"id":"vm10","type":"choice","prompt":"同じ keep ですが、after以下は追加情報です。文型を判定してください。","sentence":"He kept the key after the meeting.","choices":["SVO","SVOO","SVOC"],"answer":"SVO","skill":"verb-pattern","note":""},{"id":"vm11","type":"choice","prompt":"make の後ろの関係に注目。文型を判定してください。","sentence":"She made me a sandwich.","choices":["SVO","SVOO","SVOC"],"answer":"SVOO","skill":"verb-pattern","note":""},{"id":"vm12","type":"choice","prompt":"同じ make ですが、こちらは？","sentence":"She made me angry.","choices":["SVO","SVOO","SVOC"],"answer":"SVOC","skill":"verb-pattern","note":""},{"id":"vm13","type":"manual","prompt":"run / grow / look の例から、「動詞の単語だけ見ても文型は決まらない」理由を説明してください。","sentence":"","skill":"verb-pattern","guide":"動詞がその文でどんな意味関係を作っているか、後ろの語とどうつながるかまで見る。","lines":5,"note":""}]},{"id":"to-ing-core","title":"to / ing をイメージで理解","source":"教材③＋核イメージ","level":"標準","focus":"to・ing・時間の向き","description":"丸暗記ではなく、toの「→」と、doingが行為をひとかたまりに捉える感覚から意味差を考える。","questions":[{"id":"ti01","type":"choice","prompt":"to の核イメージとして最も近いものは？","sentence":"go to the station","choices":["→ 到達点へ向かう","← 起点から離れる","範囲の中","面に接触"],"answer":"→ 到達点へ向かう","skill":"core-image","note":""},{"id":"ti02","type":"choice","prompt":"to の核イメージが残っているのはどこ？","sentence":"Give this key to Maya.","choices":["物の到達先","時間の起点","場所の内部","面への接触"],"answer":"物の到達先","skill":"core-image","note":""},{"id":"ti03","type":"choice","prompt":"decide to leave の to を、核イメージで考えると？","sentence":"I decided to leave early.","choices":["意識がこれからの行為へ向く","すでに終えた行為を箱に入れる","過去の起点から離れる","行為を反復する"],"answer":"意識がこれからの行為へ向く","skill":"verb-form","note":""},{"id":"ti04","type":"choice","prompt":"enjoy の後ろで自然なのは？","sentence":"I enjoy ___ novels before bed.","choices":["to read","reading"],"answer":"reading","skill":"verb-form","note":""},{"id":"ti05","type":"choice","prompt":"「鍵を閉めたことを覚えている」に近いのは？","sentence":"","choices":["remember locking the door","remember to lock the door"],"answer":"remember locking the door","skill":"verb-form","note":""},{"id":"ti06","type":"choice","prompt":"「鍵を閉めるのを忘れずにやる」に近いのは？","sentence":"","choices":["remember locking the door","remember to lock the door"],"answer":"remember to lock the door","skill":"verb-form","note":""},{"id":"ti07","type":"choice","prompt":"「喫煙をやめた」に近いのは？","sentence":"","choices":["stop smoking","stop to smoke"],"answer":"stop smoking","skill":"verb-form","note":""},{"id":"ti08","type":"choice","prompt":"「タバコを吸うために立ち止まった」に近いのは？","sentence":"","choices":["stop smoking","stop to smoke"],"answer":"stop to smoke","skill":"verb-form","note":""},{"id":"ti09","type":"choice","prompt":"「試しにドアを開けてみた」に近いのは？","sentence":"","choices":["try opening the door","try to open the door"],"answer":"try opening the door","skill":"verb-form","note":""},{"id":"ti10","type":"choice","prompt":"「難しかったがドアを開けようと努力した」に近いのは？","sentence":"","choices":["try opening the door","try to open the door"],"answer":"try to open the door","skill":"verb-form","note":""},{"id":"ti11","type":"manual","prompt":"go to school / give it to Maya / want to learn の3つに共通する「toの方向感覚」を説明してください。","sentence":"","skill":"core-image","guide":"場所・受け手・これからの行為という違いはあっても、意識や物が到達点へ向かう「→」が共通。","lines":5,"note":""},{"id":"ti12","type":"manual","prompt":"remember doing / remember to do の違いを「時間の向き」で説明してください。","sentence":"","skill":"verb-form","guide":"doing はすでに起きた行為を後ろから振り返る。to do はまだ先にある行為へ意識が向く。","lines":5,"note":""}]}]